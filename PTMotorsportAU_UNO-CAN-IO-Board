// This code suits the CAN_IO_UNO_V1 board from PT Motorsport AU with Arduino UNO and MCP2515 CAN controller

#include <mcp_can.h>
#include <SPI.h>

typedef union {
  uint16_t uint16_arry[4] = {0};
  uint8_t byte_arry[8];
} Union_16x4_8x8;

long unsigned int rxId;           // storage for can data
unsigned char len = 0;            // storage for can data
unsigned char rxBuf[8];           // storage for can data

#define CAN0_INT 2                // Set INT to pin 2
MCP_CAN CAN0(4);                 // set CS pin to 10

#define LED_PIN A6                // Set CAN LED pin to analog pin 5

// Define a global variable for the base CAN address
int AVIsendCANAddress = 0x2C0;
int DPIsendCANAddress1 = 0x2C2;
int DPIsendCANAddress2 = 0x2C4;
int DPOrxCANAddress1 = 0x2D0;
int DPOrxCANAddress2 = 0x2D2;
int KeepAliveCANAddress = 0x2C6;


// Define the digital pins for the DPO outputs
const int DPO1 = 5;
const int DPO2 = 6;
const int DPO3 = 9;
const int DPO4 = 10;

//define the digital pins for the DPI inputs
const int DPI1input = 3;           // dpi 1 input
const int DPI2input = 7;           // dpi 2 input
const int DPI3input = 8;           // dpi 3 input
const int DPI4input = A4;          // dpi 4 input

bool DPI1in = 0;                   // storage for digital input value as bool
bool DPI2in = 0;                   // storage for digital input value as bool
bool DPI3in = 0;                   // storage for digital input value as bool
bool DPI4in = 0;                   // storage for digital input value as bool

unsigned long task1Interval = 100; // 100ms (10hz) interval for keep alive frame
unsigned long task2Interval = 20;  // 20ms (50hz) interval for analogue value sending
unsigned long task3Interval = 20;  // 20ms (50hz) interval for analogue value reading 
unsigned long task4Interval = 20;  // 20ms (50hz) interval for reading digital input
unsigned long task1Millis = 0;     // storage for millis counter
unsigned long task2Millis = 0;     // storage for millis counter
unsigned long task3Millis = 0;     // storage for millis counter
unsigned long task4Millis = 0;     // storage for millis counter

byte DPO1out = 0;                  // storage for DPO output 1
byte DPO2out = 0;                  // storage for DPO output 2
byte DPO3out = 0;                  // storage for DPO output 3
byte DPO4out = 0;                  // storage for DPO output 4

void setup() {
  // start serial port an send a message with delay for starting
  Serial.begin(115200);   
  Serial.println("analog reading to 12 bit test");
  delay(200);

  // initialize canbus with 1000kbit and 8mhz xtal. Only receive standard IDs for filtering
  if (CAN0.begin(MCP_STD, CAN_1000KBPS, MCP_8MHZ) == CAN_OK) 
  Serial.println("MCP2515 Initialized Successfully!");
  else Serial.println("Error Initializing MCP2515...");

  // Set operation mode to normal so the MCP2515 sends acks to received data.
  CAN0.setMode(MCP_NORMAL);  

  pinMode(CAN0_INT, INPUT);      // set INT pin to be an input
  digitalWrite(CAN0_INT, HIGH);  // set INT pin high to enable interna pullup

  // Set the pin mode for DPOs
  pinMode(DPO1, OUTPUT); 
  pinMode(DPO2, OUTPUT); 
  pinMode(DPO3, OUTPUT); 
  pinMode(DPO4, OUTPUT); 

  // Set the pin mode for DPIs
  pinMode(DPI1input, INPUT_PULLUP); // Remove "_PULLUP" if you want to use external pullup resistors, pull up to 5v only
  pinMode(DPI2input, INPUT_PULLUP);
  pinMode(DPI3input, INPUT_PULLUP);
  pinMode(DPI4input, INPUT_PULLUP);

 // IO Box A or B Mode (A5 is analog only, hence the analog read)
  pinMode(A5, INPUT_PULLUP); // Set the analog pin 5 as input
  int analogValue = analogRead(A5); // Read the analog value from pin A5

// Compare the analog value to a threshold
    if (analogValue < 512) { // Adjust the threshold as necessary
    AVIsendCANAddress++;
    DPIsendCANAddress1++;
    DPIsendCANAddress2++;
    DPOrxCANAddress1++;
    DPOrxCANAddress2++;
    KeepAliveCANAddress++;  
  }
  pinMode(LED_PIN, OUTPUT);
// Set receive filter to only accept valid RX messages
// This blocks irrelevent messages in hardware and limmits interuptions to the MCU on highly loaded busses
  CAN0.init_Mask(0,0,0x07FF0000);
  CAN0.init_Mask(1,0,0x07FF0000);
  CAN0.init_Filt(0,0,uint32_t(DPOrxCANAddress1)<<16);
  CAN0.init_Filt(1,0,uint32_t(DPOrxCANAddress2)<<16);
  
  Serial.println("All OK");  // all ready to go !
  Serial.println("Receiving IDs");
  Serial.println(DPOrxCANAddress1,HEX);
  Serial.println(DPOrxCANAddress2,HEX);
  Serial.println("Receive filters set to");
  Serial.println(uint32_t(DPOrxCANAddress1)<<16,HEX);
  Serial.println(uint32_t(DPOrxCANAddress2)<<16,HEX);
}




void loop() {

  unsigned long currentMillis = millis();  // Get current time in milliseconds

  // Execute task 1
  if (currentMillis - task1Millis >= task1Interval) {
    task1Millis = currentMillis;
    SendKeepAlive();
  }

  // Execute task 2
  if (currentMillis - task2Millis >= task2Interval) {
    task2Millis = currentMillis;
    SendAnalogValues();
  }

  // Execute task 3
  if (currentMillis - task3Millis >= task3Interval) {
    task3Millis = currentMillis;
    DriveDigitalPin();
  }

  // Execute task 4
  if (currentMillis - task4Millis >= task4Interval) {
    task4Millis = currentMillis;
    SendDPIValues();
  }

  // read can buffer when interrupted and jump to canread for processing.
  if (!digitalRead(CAN0_INT))  // If CAN0_INT pin is low, read receive buffer
  {
    CAN0.readMsgBuf(&rxId, &len, rxBuf);  // Read data: len = data length, buf = data byte(s)
    canRead();
    digitalWrite(LED_PIN, !digitalRead(LED_PIN)); // Toggle LED state
  }
}


void canRead() {
  if (rxId == DPOrxCANAddress1) {
    DPO1out = rxBuf[0];
    DPO2out = rxBuf[4];
  }

  if (rxId == DPOrxCANAddress2) {
    DPO3out = rxBuf[0];
    DPO4out = rxBuf[4];
  }
}

void DriveDigitalPin() {
    if      (DPO1out == 0x00) {digitalWrite(DPO1, LOW); }                   //drive the output low if value is 0x00
    else if (DPO1out <  0xFA) {analogWrite(DPO1 * 255 / 0xF9, DPO1out); }   //drive analogue output if the received data is < 0xFA
    else                      {digitalWrite(DPO1, HIGH); }                  //drive the output high if value is 0xFA or higher

    if      (DPO2out == 0x00) {digitalWrite(DPO2, LOW); }                   //drive the output low if value is 0x00
    else if (DPO2out <  0xFA) {analogWrite(DPO2 * 255 / 0xF9, DPO1out); }   //drive analogue output if the received data is < 0xFA
    else                      {digitalWrite(DPO2, HIGH); }                  //drive the output high if value is 0xFA or higher

    if      (DPO3out == 0x00) {digitalWrite(DPO3, LOW); }                   //drive the output low if value is 0x00
    else if (DPO3out <  0xFA) {analogWrite(DPO3 * 255 / 0xF9, DPO1out); }   //drive analogue output if the received data is < 0xFA
    else                      {digitalWrite(DPO3, HIGH); }                  //drive the output high if value is 0xFA or higher

    if      (DPO4out == 0x00) {digitalWrite(DPO4, LOW); }                   //drive the output low if value is 0x00
    else if (DPO4out <  0xFA) {analogWrite(DPO4 * 255 / 0xF9, DPO1out); }   //drive analogue output if the received data is < 0xFA
    else                      {digitalWrite(DPO4, HIGH); }                  //drive the output high if value is 0xFA or higher

}



void SendKeepAlive() {
  byte KeepAlive[5] = { 0X10, 0x09, 0x0D, 0x01, 0x00 };
  CAN0.sendMsgBuf(KeepAliveCANAddress, 0, 5, KeepAlive);
}


void SendDPIValues()
{
byte DPIdata1[8] = {0x00};
byte DPIdata2[8] = {0x00};

if (digitalRead(DPI1input) == 1) { DPIdata1[0] = 0xFA; }
if (digitalRead(DPI2input) == 1) { DPIdata1[4] = 0xFA; }
if (digitalRead(DPI3input) == 1) { DPIdata2[0] = 0xFA; }
if (digitalRead(DPI4input) == 1) { DPIdata2[4] = 0xFA; }

CAN0.sendMsgBuf(DPIsendCANAddress1, 0, 8, DPIdata1);
CAN0.sendMsgBuf(DPIsendCANAddress2, 0, 8, DPIdata2);

}


void SendAnalogValues() {

  // Create CAN message. Little Endian
  Union_16x4_8x8 canMsg;

  canMsg.uint16_arry[0] = analogRead(A0) * 4095 / 1023;  // read analogue value and scale to 12 bit
  canMsg.uint16_arry[1] = analogRead(A1) * 4095 / 1023;  // read analogue value and scale to 12 bit
  canMsg.uint16_arry[2] = analogRead(A2) * 4095 / 1023;  // read analogue value and scale to 12 bit
  canMsg.uint16_arry[3] = analogRead(A3) * 4095 / 1023;  // read analogue value and scale to 12 bit

  //constuct the can message with correct bytes in Big Endian
  byte SendAnalogue[8] = {
    canMsg.byte_arry[1],
    canMsg.byte_arry[0],
    canMsg.byte_arry[3],
    canMsg.byte_arry[2],
    canMsg.byte_arry[5],
    canMsg.byte_arry[4],
    canMsg.byte_arry[7],
    canMsg.byte_arry[6]
  };

  CAN0.sendMsgBuf(AVIsendCANAddress, 0, 8, SendAnalogue);  // send the can message onto the bus
}
