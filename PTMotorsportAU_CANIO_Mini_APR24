    digitalWrite(DPO4, LOW);
  }
} else if (DPO4out < 250) {
  int dutyCycle = activeStateDPO4 ? map(DPO4out, 0x00, 0xF9, 255, 0) : map(DPO4out, 0x00, 0xF9, 0, 255);
  analogWrite(DPO4, dutyCycle);
} else {
  if (activeStateDPO4) {
    digitalWrite(DPO4, LOW);
  } else {
    digitalWrite(DPO4, HIGH);
  }
}
}


void SendKeepAlive() {
  byte KeepAlive[5] = { 0X10, 0x09, 0x0D, 0x01, 0x00 };
  CAN0.sendMsgBuf(KeepAliveCANAddress, 0, 5, KeepAlive);
}

void SendDPIValues() {
  byte DPIdata1[8] = {0};
  byte DPIdata2[8] = {0};

  // Calculate the duty cycle and period for DPI1
  noInterrupts(); // Disable interrupts while reading shared variables
  unsigned long currentTime = micros();
  unsigned long period = highTime + lowTime;
  unsigned long dutyCycle = (period > 0) ? (highTime * 100 / period) : 0;

  // Check for timeout
  if (currentTime - lastInterruptTime > timeoutInterval) {
    period = 0;
    dutyCycle = 0;
  }
  interrupts(); // Re-enable interrupts

  // Convert duty cycle to percentage (y = x / 10) Redundant?
  // TODO: Remove?
  unsigned int dutyCyclePercent = dutyCycle * 10;

  // Convert period to milliseconds (y = x / 100) Redundant?
  // TODO: Remove?
  unsigned int periodMs = period / 10;

  // Pack the values into the CAN message for DPI1
  DPIdata1[0] = map(dutyCycle, 0, 100, 0, 250);

  // Set the high/low flag on the 5th bit of byte 1
  DPIdata1[1] = (!digitalRead(DPI1input) << 5);

  // Pack the period into bytes 1, 2, and 3
  DPIdata1[1] |= (periodMs >> 16) & 0xF0; // Period MSB (4 bits)
  DPIdata1[2] = (periodMs >> 8) & 0xFF;   // Period mid significant byte
  DPIdata1[3] = periodMs & 0xFF;          // Period LSB

  // Read the values from the digital pins for DPI2, DPI3, and DPI4
  DPI2in = !digitalRead(DPI2input);
  DPI3in = !digitalRead(DPI3input);
  DPI4in = !digitalRead(DPI4input);

  // Pack the state of DPI2 into the 5th bit of byte 5
  DPIdata1[5] |= (DPI2in << 5);

  // Pack the state of DPI3 into the 5th bit of byte 1 of the second message
  DPIdata2[1] |= (DPI3in << 5);

  // Pack the state of DPI4 into the 5th bit of byte 5 of the second message
  DPIdata2[5] |= (DPI4in << 5);

  // Send the CAN messages
  CAN0.sendMsgBuf(DPIsendCANAddress1, 0, 8, DPIdata1);
  CAN0.sendMsgBuf(DPIsendCANAddress2, 0, 8, DPIdata2);
}


void SendAnalogValues() {

  // Create CAN message. Little Endian
  Union_16x4_8x8 canMsg;

  canMsg.uint16_arry[0] = analogRead(A0) * 4095 / 1023;  // read analogue value and scale to 12 bit
  canMsg.uint16_arry[1] = analogRead(A1) * 4095 / 1023;  // read analogue value and scale to 12 bit
  canMsg.uint16_arry[2] = analogRead(A2) * 4095 / 1023;  // read analogue value and scale to 12 bit
  canMsg.uint16_arry[3] = analogRead(A3) * 4095 / 1023;  // read analogue value and scale to 12 bit

  //constuct the can message with correct bytes in Big Endian
  byte SendAnalogue[8] = {
    canMsg.byte_arry[1],
    canMsg.byte_arry[0],
    canMsg.byte_arry[3],
    canMsg.byte_arry[2],
    canMsg.byte_arry[5],
    canMsg.byte_arry[4],
    canMsg.byte_arry[7],
    canMsg.byte_arry[6]
  };

  CAN0.sendMsgBuf(AVIsendCANAddress, 0, 8, SendAnalogue);  // send the can message onto the bus
}

