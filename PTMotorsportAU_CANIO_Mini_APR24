#include <mcp_can.h>
#include <SPI.h>
#include <EEPROM.h>
typedef union {
  uint16_t uint16_arry[4] = {0};
  uint8_t byte_arry[8];
} Union_16x4_8x8;

long unsigned int rxId;           // storage for can data
unsigned char len = 0;            // storage for can data
unsigned char rxBuf[8];           // storage for can data

#define CAN0_INT 2                // Set INT to pin 2
MCP_CAN CAN0(4);                 // set CS pin to 10

#define LED_PIN A5                // Set CAN LED pin to analog pin 5

// Define a global variable for the base CAN address
int AVIsendCANAddress = 0x2C0;
int DPIsendCANAddress1 = 0x2C2;
int DPIsendCANAddress2 = 0x2C4;
int DPOrxCANAddress1 = 0x2D0;
int DPOrxCANAddress2 = 0x2D2;
int KeepAliveCANAddress = 0x2C6;


// Define the digital pins for the DPO outputs
const int DPO1 = 5;
const int DPO2 = 6;
const int DPO3 = 9;
const int DPO4 = 10;

// Define Digital Output Active and Safe States
unsigned long lastCANMessageTime = 0; // Time of last CAN message received
bool safeStateDPO1, safeStateDPO2, safeStateDPO3, safeStateDPO4; // Safe state of the DPOs
bool activeStateDPO1, activeStateDPO2, activeStateDPO3, activeStateDPO4; // Active state of the DPOs

//define the digital pins for the DPI inputs
const int DPI1input = 3;           // dpi 1 input
const int DPI2input = 7;           // dpi 2 input
const int DPI3input = 8;           // dpi 3 input
const int DPI4input = A4;          // dpi 4 input

bool DPI1in = 0;                   // storage for digital input value as bool
bool DPI2in = 0;                   // storage for digital input value as bool
bool DPI3in = 0;                   // storage for digital input value as bool
bool DPI4in = 0;                   // storage for digital input value as bool

volatile unsigned long lastTime = 0; // DI1 time storage (Freq read)
volatile unsigned long highTime = 0;
volatile unsigned long lowTime = 0;
volatile bool lastState = LOW;
volatile unsigned long lastInterruptTime = 0;
const unsigned long timeoutInterval = 2000000; // 2 seconds in microseconds

unsigned long task1Interval = 100; // 100ms (10hz) interval for keep alive frame
unsigned long task2Interval = 20;  // 20ms (50hz) interval for analogue value sending
unsigned long task3Interval = 20;  // 20ms (50hz) interval for analogue value reading 
unsigned long task4Interval = 20;  // 20ms (50hz) interval for reading digital input
unsigned long task5Interval = 200;  // 200ms (5hz) interval for Blinking the LED
unsigned long task6Interval = 2000;  // 2000ms interval for serial print debug
unsigned long task1Millis = 0;     // storage for millis counter
unsigned long task2Millis = 0;     // storage for millis counter
unsigned long task3Millis = 0;     // storage for millis counter
unsigned long task4Millis = 0;     // storage for millis counter
unsigned long task5Millis = 0;     // storage for millis counter
unsigned long task6Millis = 0;     // storage for millis counter

byte DPO1out = 0;                  // storage for DPO output 1
byte DPO2out = 0;                  // storage for DPO output 2
byte DPO3out = 0;                  // storage for DPO output 3
byte DPO4out = 0;                  // storage for DPO output 4

void setup() {
  // start serial port an send a message with delay for starting
  Serial.begin(115200);   
  Serial.println("analog reading to 12 bit test");
  delay(200);

  // initialize canbus with 1000kbit and 8mhz xtal. Only receive standard IDs for filtering
  if (CAN0.begin(MCP_STD, CAN_1000KBPS, MCP_8MHZ) == CAN_OK) 
  Serial.println("MCP2515 Initialized Successfully!");
  else Serial.println("Error Initializing MCP2515...");

  // Set operation mode to normal so the MCP2515 sends acks to received data.
  CAN0.setMode(MCP_NORMAL);  

  pinMode(CAN0_INT, INPUT);      // set INT pin to be an input
  digitalWrite(CAN0_INT, HIGH);  // set INT pin high to enable interna pullup

  // Set the pin mode for DPOs
  pinMode(DPO1, OUTPUT); 
  pinMode(DPO2, OUTPUT); 
  pinMode(DPO3, OUTPUT); 
  pinMode(DPO4, OUTPUT); 

  // Read DPO safe state from EEPROM
  safeStateDPO1 = EEPROM.read(0);
  safeStateDPO2 = EEPROM.read(1);
  safeStateDPO3 = EEPROM.read(2);
  safeStateDPO4 = EEPROM.read(3);

  // Set the pin mode for DPIs
  pinMode(DPI1input, INPUT_PULLUP); // Remove "_PULLUP" if you want to use external pullup resistors, pull up to 5v only
  pinMode(DPI2input, INPUT_PULLUP);
  pinMode(DPI3input, INPUT_PULLUP);
  pinMode(DPI4input, INPUT_PULLUP);

  // Set up the interrupt for DPI1 (pin D3)
  attachInterrupt(digitalPinToInterrupt(DPI1input), handleDPI1Interrupt, CHANGE);


 // IO Box A or B Mode (A7 is analog only, hence the analog read)
pinMode(A7, INPUT); // Set the analog pin 7 as input (needs an external pullup resisitor 10k or 20k)
int analogValue = analogRead(A7); // Read the analog value from pin A7

// Compare the analog value to a threshold
    if (analogValue < 512) { // Adjust the threshold as necessary
    AVIsendCANAddress++;
    DPIsendCANAddress1++;
    DPIsendCANAddress2++;
    DPOrxCANAddress1++;
    DPOrxCANAddress2++;
    KeepAliveCANAddress++;  
  }

// Set receive filter to only accept valid RX messages
// This blocks irrelevent messages in hardware and limmits interuptions to the MCU on highly loaded busses
  CAN0.init_Mask(0,0,0x07FF0000);
  CAN0.init_Mask(1,0,0x07FF0000);
  CAN0.init_Filt(0,0,uint32_t(DPOrxCANAddress1)<<16);
  CAN0.init_Filt(1,0,uint32_t(DPOrxCANAddress2)<<16);
  
  Serial.println("All OK");  // all ready to go !
  Serial.println("Receiving IDs");
  Serial.println(DPOrxCANAddress1,HEX);
  Serial.println(DPOrxCANAddress2,HEX);
  Serial.println("Receive filters set to");
  Serial.println(uint32_t(DPOrxCANAddress1)<<16,HEX);
  Serial.println(uint32_t(DPOrxCANAddress2)<<16,HEX);
}




void loop() {

  unsigned long currentMillis = millis();  // Get current time in milliseconds

  // Execute task 1
  if (currentMillis - task1Millis >= task1Interval) {
    task1Millis = currentMillis;
    SendKeepAlive();
  }

  // Execute task 2
  if (currentMillis - task2Millis >= task2Interval) {
    task2Millis = currentMillis;
    SendAnalogValues();
  }

  // Execute task 3
  if (currentMillis - task3Millis >= task3Interval) {
    task3Millis = currentMillis;
    DPOSafeSate();
  }

  // Execute task 4
  if (currentMillis - task4Millis >= task4Interval) {
    task4Millis = currentMillis;
    SendDPIValues();
  }

    // Execute task 6
  if (currentMillis - task6Millis >= task6Interval) {
    task6Millis = currentMillis;
    //debugPrint();
  }

  // read can buffer when interrupted and jump to canread for processing.
  if (!digitalRead(CAN0_INT))  // If CAN0_INT pin is low, read receive buffer
  {
    CAN0.readMsgBuf(&rxId, &len, rxBuf);  // Read data: len = data length, buf = data byte(s)
    canRead();
  }
}

void handleDPI1Interrupt() {
  unsigned long currentTime = micros();
  bool currentState = digitalRead(DPI1input);

  if (currentState == HIGH && lastState == LOW) {
    // Rising edge
    lowTime = currentTime - lastTime;
    lastTime = currentTime;
  } else if (currentState == LOW && lastState == HIGH) {
    // Falling edge
    highTime = currentTime - lastTime;
    lastTime = currentTime;
  }

  lastState = currentState;
  lastInterruptTime = currentTime; // Update the last interrupt time
}

void canRead() {
  lastCANMessageTime = millis();
  if (rxId == DPOrxCANAddress1) {
    DPO1out = rxBuf[0];
    DPO2out = rxBuf[4];
  }

  if (rxId == DPOrxCANAddress2) {
    DPO3out = rxBuf[0];
    DPO4out = rxBuf[4];
  }
}

void DPOSafeSate() {
  
    if (rxId == DPOrxCANAddress1) {
      bool newSafeStateDPO1 = bitRead(rxBuf[1], 4);
      bool newSafeStateDPO2 = bitRead(rxBuf[5], 4);
      bool newActiveStateDPO1 = bitRead(rxBuf[1], 5);
      bool newActiveStateDPO2 = bitRead(rxBuf[5], 5);

      if (newSafeStateDPO1 != safeStateDPO1) {
        safeStateDPO1 = newSafeStateDPO1;
        EEPROM.write(0, safeStateDPO1);
      }
      if (newSafeStateDPO2 != safeStateDPO2) {
        safeStateDPO2 = newSafeStateDPO2;
        EEPROM.write(1, safeStateDPO2);
      }
      activeStateDPO1 = newActiveStateDPO1;
      activeStateDPO2 = newActiveStateDPO2;
    }

    if (rxId == DPOrxCANAddress2) {
      bool newSafeStateDPO3 = bitRead(rxBuf[1], 4);
      bool newSafeStateDPO4 = bitRead(rxBuf[5], 4);
      bool newActiveStateDPO3 = bitRead(rxBuf[1], 5);
      bool newActiveStateDPO4 = bitRead(rxBuf[5], 5);

      if (newSafeStateDPO3 != safeStateDPO3) {
        safeStateDPO3 = newSafeStateDPO3;
        EEPROM.write(2, safeStateDPO3);
      }
      if (newSafeStateDPO4 != safeStateDPO4) {
        safeStateDPO4 = newSafeStateDPO4;
        EEPROM.write(3, safeStateDPO4);
      }
      activeStateDPO3 = newActiveStateDPO3;
      activeStateDPO4 = newActiveStateDPO4;
    }

  if (millis() - lastCANMessageTime > 2000) {
    digitalWrite(DPO1, safeStateDPO1);
    digitalWrite(DPO2, safeStateDPO2);
    digitalWrite(DPO3, safeStateDPO3);
    digitalWrite(DPO4, safeStateDPO4);
    digitalWrite(LED_PIN, LOW); // Extinguish LED state
  } else {
    unsigned long currentMillis = millis(); // Get the current time

    if (currentMillis - task5Millis >= task5Interval) {
      task5Millis = currentMillis;
      digitalWrite(LED_PIN, !digitalRead(LED_PIN)); // Blink the LED
      DriveDigitalPin(); // Drive the digital pins
    }
  }
}

void DriveDigitalPin() {

if (DPO1out == 0) {
  if (activeStateDPO1) {
    digitalWrite(DPO1, HIGH);
  } else {
    digitalWrite(DPO1, LOW);
  }
} else if (DPO1out < 250) {
  int dutyCycle = activeStateDPO1 ? map(DPO1out, 0x00, 0xF9, 255, 0) : map(DPO1out, 0x00, 0xF9, 0, 255);
  analogWrite(DPO1, dutyCycle);
} else {
  if (activeStateDPO1) {
    digitalWrite(DPO1, LOW);
  } else {
    digitalWrite(DPO1, HIGH);
  }
}

if (DPO2out == 0) {
  if (activeStateDPO2) {
    digitalWrite(DPO2, HIGH);
  } else {
    digitalWrite(DPO2, LOW);
  }
} else if (DPO2out < 250) {
  int dutyCycle = activeStateDPO2 ? map(DPO2out, 0x00, 0xF9, 255, 0) : map(DPO2out, 0x00, 0xF9, 0, 255);
  analogWrite(DPO2, dutyCycle);
} else {
  if (activeStateDPO2) {
    digitalWrite(DPO2, LOW);
  } else {
    digitalWrite(DPO2, HIGH);
  }
}

if (DPO3out == 0) {
  if (activeStateDPO3) {
    digitalWrite(DPO3, HIGH);
  } else {
    digitalWrite(DPO3, LOW);
  }
} else if (DPO3out < 250) {
  int dutyCycle = activeStateDPO3 ? map(DPO3out, 0x00, 0xF9, 255, 0) : map(DPO3out, 0x00, 0xF9, 0, 255);
  analogWrite(DPO3, dutyCycle);
} else {
  if (activeStateDPO3) {
    digitalWrite(DPO3, LOW);
